<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.esdllm</groupId>
    <artifactId>bilibili-api</artifactId>
    <version>0.10.0-SNAPSHOT</version>
    <name>bilibili-api</name>
    <description>哔哩哔哩（Bilibili）常用数据接口的 Java 客户端：用户名片、视频、动态、直播间、短链解析、搜索、用户空间与 AI 视频摘要，并支持登录（扫码 / 密码 / 短信）与 WBI 签名。</description>

    <properties>
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>17</java.version>
        <maven.surefire.plugin.version>3.5.4</maven.surefire.plugin.version>
        <!-- 编译目标：release 已同时约束语法版本与字节码版本，无需再写 source/target -->
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <!-- 保留方法形参名（反射可获取真实参数名） -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <!-- 生成调试信息：异常堆栈可显示源码行号 -->
        <maven.compiler.debug>true</maven.compiler.debug>
        <!-- 输出告警：deprecation 用于提示过时 API，warnings 覆盖 unchecked 等其余告警 -->
        <maven.compiler.showDeprecation>true</maven.compiler.showDeprecation>
        <maven.compiler.showWarnings>true</maven.compiler.showWarnings>


        <!-- 测试：junit-jupiter -->
        <junit.version>5.11.4</junit.version>
        <!-- Lombok 仅在编译期生成代码，运行期不需要，声明为 provided 避免传递给下游 -->
        <lombok.version>1.18.42</lombok.version>
        <!-- JSON 序列化：fastjson2（2026-09-22 从 1.2.83 迁来）。
             坐标是 `com.alibaba.fastjson2:fastjson2`，与 1.x 的 `com.alibaba:fastjson`
             **不是同一个坐标** ⇒ 下游若还留着 1.x 也不会冲突（下游可共存）。
             2.x 相对 1.x 最实际的一条收益：**autotype 默认关闭**（1.x 的反序列化漏洞面主要来自它）。
             本库实测**只用到 4 个符号**（JSONObject / JSON / TypeReference / JSONArray），
             且**全库零 `@JSONField`** ⇒ 迁移不需改任何注解，行为差异只在个别强制转换上。 -->
        <fastjson2.version>2.0.56</fastjson2.version>
        <!-- HTTP 请求 -->
        <unirest-java.version>3.13.2</unirest-java.version>
        <httpclient.version>4.5.14</httpclient.version>
        <!-- 日志 -->
        <slf4j.version>2.0.16</slf4j.version>
        <logback.version>1.5.12</logback.version>
        <!-- 测试：二维码渲染 -->
        <qrcode.version>3.3.3</qrcode.version>

        <!-- surefire 的 argLine 追加位：默认空，命令行可覆盖。
             这里**必须留一个空定义**，否则未传参时 ${argLine} 会以字面量形式进入 JVM 参数。
             存在的理由：`smoke/*` 测试全部靠 `-Dbili.smoke=true` 开关，而开关只能通过
             forked JVM 的系统属性传进去（见下面 surefire 的 argLine）。
             2026-09-22 之前 pom 把 argLine 写死成 `-Dfile.encoding=UTF-8`（**没有引用本属性**），
             于是命令行 `-DargLine=-Dbili.smoke=true` 被静默丢弃 ——
             **所有 smoke 测试的"跑法"注释都因此从未真正生效**。 -->
        <argLine/>
    </properties>
    <dependencies>
        <!-- JSON 序列化（fastjson2；坐标与 1.x 的 com.alibaba:fastjson 不同，见上面 properties 的说明） -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>${fastjson2.version}</version>
        </dependency>

        <!-- HTTP 请求 -->
        <dependency>
            <groupId>com.konghq</groupId>
            <artifactId>unirest-java</artifactId>
            <version>${unirest-java.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
            <version>${httpclient.version}</version>
        </dependency>

        <!-- Lombok 仅在编译期生成代码，运行期不需要，声明为 provided 避免传递给下游 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- 日志 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!-- 测试：junit-jupiter 聚合包同时提供 api / params / engine。
             只引 junit-jupiter-api 会让 surefire 找不到引擎，测试实际不会被执行 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- 测试：二维码渲染（仅测试期使用，scope=test 不进入下游依赖树）。
             Login 门面只负责「拿到二维码内容」，把它画成可扫的图是调用方的事；
             联调冒烟要让用户真能扫码，需要一份本地渲染实现，故只引 core
             （只用 QRCodeWriter + BitMatrix，PNG 用 JDK 自带的 ImageIO 写，不引 javase）。 -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${qrcode.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <!-- 显式声明注解处理器路径：JDK 23 起 javac 默认不再从 classpath 自动发现处理器，
                         缺少这段配置会让 Lombok 完全失效，编译时报大量“找不到符号” -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <configuration>
                    <!-- ${argLine} 是命令行的注入点（默认空，见 <properties>）。
                         写死不引用它，会让 `mvn test -DargLine=-Dbili.smoke=true` 静默失效。 -->
                    <argLine>${argLine} -Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
